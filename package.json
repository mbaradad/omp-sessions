				},
				{ "command": "omp.editWithOmp", "when": "resourceScheme == file && !editorReadonly", "group": "omp@5" },
				{ "command": "omp.writeTests", "when": "resourceScheme == file", "group": "omp@6" },
				{ "command": "omp.addDocs", "when": "resourceScheme == file && !editorReadonly", "group": "omp@7" },
				{ "command": "omp.fixFileProblems", "when": "resourceScheme == file", "group": "omp@8" }
			],
			"scm/title": [
				{ "command": "omp.scm.commit", "when": "scmProvider == git", "group": "omp@1" },
				{ "command": "omp.scm.review", "when": "scmProvider == git", "group": "omp@2" },
				{ "command": "omp.scm.pr", "when": "scmProvider == git", "group": "omp@3" },
				{ "command": "omp.commitInTerminal", "when": "scmProvider == git", "group": "omp@4" },
				{ "command": "omp.gitUi", "when": "scmProvider == git", "group": "omp@5" }
