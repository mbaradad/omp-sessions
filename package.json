					"when": "explorerResourceIsFolder",
					"group": "omp@2"
				},
				{
					"command": "omp.addToChat",
					"when": "resourceScheme == file",
					"group": "omp@3"
				},
				{ "command": "omp.explainFile", "when": "resourceScheme == file && !explorerResourceIsFolder", "group": "omp@4" },
				{ "command": "omp.fixFileProblems", "when": "resourceScheme == file && !explorerResourceIsFolder", "group": "omp@5" }
			],
			"commandPalette": [
				{ "command": "omp.showOmpMissing", "when": "false" },
