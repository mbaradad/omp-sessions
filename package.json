{
	"name": "omp-sessions",
	"displayName": "omp Sessions",
	"description": "Run oh-my-pi (omp) agent sessions in the background per folder, detach/reattach from VS Code, with clickable files and native diffs.",
	"version": "0.3.0",
	"publisher": "mbaradad",
	"license": "MIT",
	"author": "Manel Baradad <manelbaradad@gmail.com>",
	"private": true,
	"icon": "media/icon.png",
	"repository": {
		"type": "git",
		"url": "https://github.com/mbaradad/omp-vscode.git"
	},
	"bugs": {
		"url": "https://github.com/mbaradad/omp-vscode/issues"
	},
	"homepage": "https://github.com/mbaradad/omp-vscode#readme",
	"keywords": [
		"omp",
		"oh-my-pi",
		"agent",
		"ai",
		"remote-ssh",
		"background"
	],
	"galleryBanner": {
		"color": "#2b3a67",
		"theme": "dark"
	},
	"engines": {
		"vscode": "^1.100.0"
	},
	"extensionKind": [
		"workspace"
	],
	"categories": [
		"AI",
		"Chat",
		"Other"
	],
	"main": "./out/extension.js",
	"activationEvents": [
		"onStartupFinished",
		"onWebviewPanel:omp.chat"
	],
	"contributes": {
		"viewsContainers": {
			"activitybar": [
				{
					"id": "omp",
					"title": "omp",
					"icon": "media/omp.svg"
				}
			]
		},
		"views": {
			"omp": [
				{
					"id": "omp.sessions",
					"name": "Sessions",
					"icon": "media/omp.svg"
				},
				{
					"type": "webview",
					"id": "omp.chatView",
					"name": "Chat",
					"icon": "media/omp.svg"
				},
				{
					"id": "omp.tasks",
					"name": "Tasks",
					"icon": "$(checklist)"
				}
			]
		},
		"viewsWelcome": [
			{
				"view": "omp.sessions",
				"contents": "No omp sessions for this workspace yet.\n[Start omp session](command:omp.newSession)\n[Resume an omp transcript](command:omp.resumeFromHistory)\nSessions keep running on this machine when VS Code disconnects."
			},
			{
				"view": "omp.tasks",
				"contents": "Queue work for omp: tasks run one after another in the background, even with VS Code closed. Subtasks, drag & drop to reorder, check to complete.\n[Add task](command:omp.tasks.add)"
			}
		],
		"commands": [
			{
				"command": "omp.newSession",
				"title": "New Session",
				"category": "omp",
				"icon": "$(add)"
			},
			{
				"command": "omp.newSessionWithOptions",
				"title": "New Session with Options…",
				"category": "omp",
				"icon": "$(settings-gear)"
			},
			{
				"command": "omp.reviewChanges",
				"title": "Review Changes",
				"category": "omp",
				"icon": "$(diff-multiple)"
			},
			{
				"command": "omp.openSession",
				"title": "Open Session…",
				"category": "omp",
				"icon": "$(comment-discussion)"
			},
			{
				"command": "omp.focus",
				"title": "Focus Chat",
				"category": "omp"
			},
			{
				"command": "omp.stopSession",
				"title": "Stop Session",
				"category": "omp",
				"icon": "$(debug-stop)"
			},
			{
				"command": "omp.resumeSession",
				"title": "Resume Session",
				"category": "omp",
				"icon": "$(debug-start)"
			},
			{
				"command": "omp.deleteSession",
				"title": "Remove Session",
				"category": "omp",
				"icon": "$(trash)"
			},
			{
				"command": "omp.renameSession",
				"title": "Rename Session…",
				"category": "omp",
				"icon": "$(edit)"
			},
			{
				"command": "omp.showChanges",
				"title": "Show Changed Files…",
				"category": "omp",
				"icon": "$(list-tree)"
			},
			{
				"command": "omp.openSessionFileDiff",
				"title": "Open Session Diff",
				"category": "omp"
			},
			{
				"command": "omp.resumeFromHistory",
				"title": "Resume omp Transcript in Background…",
				"category": "omp",
				"icon": "$(history)"
			},
			{
				"command": "omp.sendSelection",
				"title": "Send Selection to omp",
				"category": "omp"
			},
			{
				"command": "omp.showLog",
				"title": "Show Session Host Log",
				"category": "omp",
				"icon": "$(output)"
			},
			{
				"command": "omp.refresh",
				"title": "Refresh",
				"category": "omp",
				"icon": "$(refresh)"
			},
			{
				"command": "omp.toggleGrouping",
				"title": "Toggle Group by Project",
				"category": "omp",
				"icon": "$(list-tree)"
			},
			{
				"command": "omp.addToChat",
				"title": "Add to omp Chat",
				"category": "omp",
				"icon": "$(mention)"
			},
			{
				"command": "omp.sendTerminalSelection",
				"title": "Send Terminal Selection to omp",
				"category": "omp",
				"icon": "$(terminal)"
			},
			{
				"command": "omp.explainSelection",
				"title": "Explain Selection with omp",
				"category": "omp",
				"icon": "$(question)"
			},
			{
				"command": "omp.askAboutSelection",
				"title": "Ask omp about Selection…",
				"category": "omp",
				"icon": "$(comment)"
			},
			{
				"command": "omp.fixDiagnostics",
				"title": "Fix Problems at Cursor with omp",
				"category": "omp",
				"icon": "$(wrench)"
			},
			{
				"command": "omp.revertFile",
				"title": "Revert File to Before Session",
				"category": "omp",
				"icon": "$(discard)"
			},
			{ "command": "omp.openInSidebar", "title": "Open in Side Bar", "category": "omp", "icon": "$(layout-sidebar-left)" },
			{ "command": "omp.openInEditor", "title": "Open in Editor Tab", "category": "omp", "icon": "$(go-to-file)" },
			{ "command": "omp.scm.commit", "title": "Commit with omp", "category": "omp", "icon": "$(git-commit)" },
			{ "command": "omp.scm.review", "title": "Review Uncommitted Changes with omp", "category": "omp", "icon": "$(checklist)" },
			{ "command": "omp.scm.pr", "title": "Write PR Description with omp", "category": "omp", "icon": "$(git-pull-request)" },
			{
				"command": "omp.tasks.add",
				"title": "Add Task…",
				"category": "omp",
				"icon": "$(add)"
			},
			{
				"command": "omp.tasks.addSubtask",
				"title": "Add Subtask…",
				"category": "omp",
				"icon": "$(list-tree)"
			},
			{
				"command": "omp.tasks.edit",
				"title": "Rename…",
				"category": "omp",
				"icon": "$(edit)"
			},
			{
				"command": "omp.tasks.editNotes",
				"title": "Edit Details…",
				"category": "omp",
				"icon": "$(note)"
			},
			{
				"command": "omp.tasks.delete",
				"title": "Delete",
				"category": "omp",
				"icon": "$(trash)"
			},
			{
				"command": "omp.tasks.runNow",
				"title": "Run Now",
				"category": "omp",
				"icon": "$(play)"
			},
			{
				"command": "omp.tasks.start",
				"title": "Start Queue",
				"category": "omp",
				"icon": "$(run-all)"
			},
			{
				"command": "omp.tasks.pause",
				"title": "Pause Queue",
				"category": "omp",
				"icon": "$(debug-pause)"
			},
			{
				"command": "omp.tasks.markDone",
				"title": "Mark Done",
				"category": "omp",
				"icon": "$(check)"
			},
			{
				"command": "omp.tasks.markPending",
				"title": "Mark Pending (re-run)",
				"category": "omp",
				"icon": "$(refresh)"
			},
			{
				"command": "omp.tasks.skip",
				"title": "Skip",
				"category": "omp",
				"icon": "$(circle-slash)"
			},
			{
				"command": "omp.tasks.moveUp",
				"title": "Move Up",
				"category": "omp",
				"icon": "$(arrow-up)"
			},
			{
				"command": "omp.tasks.moveDown",
				"title": "Move Down",
				"category": "omp",
				"icon": "$(arrow-down)"
			},
			{
				"command": "omp.tasks.clearDone",
				"title": "Clear Finished Tasks",
				"category": "omp",
				"icon": "$(clear-all)"
			},
			{
				"command": "omp.tasks.openChat",
				"title": "Open Chat",
				"category": "omp",
				"icon": "$(comment-discussion)"
			}
		],
		"menus": {
			"view/title": [
				{
					"command": "omp.newSession",
					"when": "view == omp.sessions",
					"group": "navigation@1"
				},
				{
					"command": "omp.resumeFromHistory",
					"when": "view == omp.sessions",
					"group": "navigation@2"
				},
				{
					"command": "omp.refresh",
					"when": "view == omp.sessions",
					"group": "navigation@3"
				},
				{
					"command": "omp.newSessionWithOptions",
					"when": "view == omp.sessions",
					"group": "1_new@1"
				},
				{
					"command": "omp.toggleGrouping",
					"when": "view == omp.sessions",
					"group": "2_view@1"
				},
				{
					"command": "omp.tasks.add",
					"when": "view == omp.tasks",
					"group": "navigation@1"
				},
				{
					"command": "omp.tasks.start",
					"when": "view == omp.tasks",
					"group": "navigation@2"
				},
				{
					"command": "omp.tasks.pause",
					"when": "view == omp.tasks",
					"group": "navigation@3"
				},
				{
					"command": "omp.tasks.clearDone",
					"when": "view == omp.tasks",
					"group": "1_tasks@1"
				}
			],
			"view/item/context": [
				{ "command": "omp.openInSidebar", "when": "view == omp.sessions && viewItem =~ /^session/", "group": "0_open@1" },
				{ "command": "omp.openInEditor", "when": "view == omp.sessions && viewItem =~ /^session/", "group": "0_open@2" },
				{
					"command": "omp.tasks.add",
					"when": "view == omp.tasks && viewItem =~ /^tasks\\.session/",
					"group": "inline@1"
				},
				{
					"command": "omp.tasks.start",
					"when": "view == omp.tasks && viewItem == tasks.session.paused",
					"group": "inline@2"
				},
				{
					"command": "omp.tasks.pause",
					"when": "view == omp.tasks && viewItem == tasks.session.auto",
					"group": "inline@2"
				},
				{
					"command": "omp.tasks.openChat",
					"when": "view == omp.tasks && viewItem =~ /^tasks\\.session/",
					"group": "inline@3"
				},
				{
					"command": "omp.tasks.clearDone",
					"when": "view == omp.tasks && viewItem =~ /^tasks\\.session/",
					"group": "1_session@1"
				},
				{
					"command": "omp.tasks.runNow",
					"when": "view == omp.tasks && viewItem =~ /^tasks\\.task\\.(pending|failed|skipped|done)$/",
					"group": "inline@1"
				},
				{
					"command": "omp.tasks.addSubtask",
					"when": "view == omp.tasks && viewItem =~ /^tasks\\.task\\./",
					"group": "inline@2"
				},
				{
					"command": "omp.tasks.delete",
					"when": "view == omp.tasks && viewItem =~ /^tasks\\.(task\\.(pending|failed|skipped|done)|subtask)$/",
					"group": "inline@3"
				},
				{
					"command": "omp.tasks.edit",
					"when": "view == omp.tasks && viewItem =~ /^tasks\\.(task\\.|subtask)/",
					"group": "1_edit@1"
				},
				{
					"command": "omp.tasks.editNotes",
					"when": "view == omp.tasks && viewItem =~ /^tasks\\.task\\./",
					"group": "1_edit@2"
				},
				{
					"command": "omp.tasks.moveUp",
					"when": "view == omp.tasks && viewItem =~ /^tasks\\.(task\\.|subtask)/",
					"group": "2_move@1"
				},
				{
					"command": "omp.tasks.moveDown",
					"when": "view == omp.tasks && viewItem =~ /^tasks\\.(task\\.|subtask)/",
					"group": "2_move@2"
				},
				{
					"command": "omp.tasks.markDone",
					"when": "view == omp.tasks && viewItem =~ /^tasks\\.task\\.(pending|failed|skipped)$/",
					"group": "3_status@1"
				},
				{
					"command": "omp.tasks.markPending",
					"when": "view == omp.tasks && viewItem =~ /^tasks\\.task\\.(done|failed|skipped)$/",
					"group": "3_status@2"
				},
				{
					"command": "omp.tasks.skip",
					"when": "view == omp.tasks && viewItem == tasks.task.pending",
					"group": "3_status@3"
				},
				{
					"command": "omp.tasks.openChat",
					"when": "view == omp.tasks && viewItem =~ /^tasks\\.task\\./",
					"group": "4_open@1"
				},
				{
					"command": "omp.tasks.delete",
					"when": "view == omp.tasks && viewItem =~ /^tasks\\.(task\\.(pending|failed|skipped|done)|subtask)$/",
					"group": "5_delete@1"
				},
				{
					"command": "omp.stopSession",
					"when": "view == omp.sessions && viewItem == session.running",
					"group": "inline@2"
				},
				{
					"command": "omp.resumeSession",
					"when": "view == omp.sessions && viewItem == session.stopped",
					"group": "inline@1"
				},
				{
					"command": "omp.deleteSession",
					"when": "view == omp.sessions && viewItem == session.stopped",
					"group": "inline@2"
				},
				{
					"command": "omp.newSession",
					"when": "view == omp.sessions && viewItem == project",
					"group": "inline@0"
				},
				{
					"command": "omp.newSessionWithOptions",
					"when": "view == omp.sessions && viewItem == project",
					"group": "1_project@1"
				},
				{
					"command": "omp.reviewChanges",
					"when": "view == omp.sessions && viewItem =~ /^session/",
					"group": "inline@0"
				},
				{
					"command": "omp.reviewChanges",
					"when": "view == omp.sessions && viewItem =~ /^session/",
					"group": "1_session@0"
				},
				{
					"command": "omp.showChanges",
					"when": "view == omp.sessions && viewItem =~ /^session/",
					"group": "1_session@1"
				},
				{
					"command": "omp.renameSession",
					"when": "view == omp.sessions && viewItem =~ /^session/",
					"group": "1_session@2"
				},
				{
					"command": "omp.showLog",
					"when": "view == omp.sessions && viewItem =~ /^session/",
					"group": "1_session@3"
				},
				{
					"command": "omp.stopSession",
					"when": "view == omp.sessions && viewItem == session.running",
					"group": "2_lifecycle@1"
				},
				{
					"command": "omp.resumeSession",
					"when": "view == omp.sessions && viewItem == session.stopped",
					"group": "2_lifecycle@1"
				},
				{
					"command": "omp.deleteSession",
					"when": "view == omp.sessions && viewItem == session.stopped",
					"group": "2_lifecycle@2"
				},
				{
					"command": "omp.revertFile",
					"when": "view == omp.sessions && viewItem == file",
					"group": "inline@1"
				},
				{
					"command": "omp.revertFile",
					"when": "view == omp.sessions && viewItem == file",
					"group": "1_file@1"
				}
			],
			"editor/context": [
				{
					"command": "omp.sendSelection",
					"when": "editorHasSelection",
					"group": "omp@1"
				},
				{
					"command": "omp.explainSelection",
					"when": "editorHasSelection && resourceScheme == file",
					"group": "omp@2"
				},
				{
					"command": "omp.askAboutSelection",
					"when": "editorHasSelection && resourceScheme == file",
					"group": "omp@3"
				},
				{
					"command": "omp.addToChat",
					"when": "!editorHasSelection && resourceScheme == file",
					"group": "omp@4"
				}
			],
			"scm/title": [
				{ "command": "omp.scm.commit", "when": "scmProvider == git", "group": "omp@1" },
				{ "command": "omp.scm.review", "when": "scmProvider == git", "group": "omp@2" },
				{ "command": "omp.scm.pr", "when": "scmProvider == git", "group": "omp@3" }
			],
			"explorer/context": [
				{
					"command": "omp.newSession",
					"when": "explorerResourceIsFolder",
					"group": "omp@1"
				},
				{
					"command": "omp.newSessionWithOptions",
					"when": "explorerResourceIsFolder",
					"group": "omp@2"
				},
				{
					"command": "omp.addToChat",
					"when": "resourceScheme == file",
					"group": "omp@3"
				}
			],
			"commandPalette": [
				{
					"command": "omp.tasks.addSubtask",
					"when": "false"
				},
				{
					"command": "omp.tasks.edit",
					"when": "false"
				},
				{
					"command": "omp.tasks.editNotes",
					"when": "false"
				},
				{
					"command": "omp.tasks.delete",
					"when": "false"
				},
				{
					"command": "omp.tasks.runNow",
					"when": "false"
				},
				{
					"command": "omp.tasks.markDone",
					"when": "false"
				},
				{
					"command": "omp.tasks.markPending",
					"when": "false"
				},
				{
					"command": "omp.tasks.skip",
					"when": "false"
				},
				{
					"command": "omp.tasks.moveUp",
					"when": "false"
				},
				{
					"command": "omp.tasks.moveDown",
					"when": "false"
				},
				{
					"command": "omp.tasks.openChat",
					"when": "false"
				},
				{
					"command": "omp.openSessionFileDiff",
					"when": "false"
				},
				{
					"command": "omp.revertFile",
					"when": "false"
				},
				{
					"command": "omp.explainSelection",
					"when": "editorHasSelection && resourceScheme == file"
				},
				{
					"command": "omp.askAboutSelection",
					"when": "editorHasSelection && resourceScheme == file"
				},
				{
					"command": "omp.fixDiagnostics",
					"when": "editorIsOpen && resourceScheme == file"
				}
			],
			"editor/title/context": [
				{
					"command": "omp.addToChat",
					"when": "resourceScheme == file",
					"group": "omp@1"
				}
			],
			"terminal/context": [
				{
					"command": "omp.sendTerminalSelection",
					"when": "terminalTextSelected",
					"group": "omp@1"
				}
			]
		},
		"walkthroughs": [
			{
				"id": "omp.gettingStarted",
				"title": "omp: background coding agent",
				"description": "Run omp sessions that keep working while VS Code is closed, review their changes, and queue work.",
				"steps": [
					{ "id": "start", "title": "Start a background session", "description": "Sessions survive VS Code, sleep and SSH drops.\n[Start a session](command:omp.newSession)", "media": { "markdown": "media/walkthrough/start.md" }, "completionEvents": ["onCommand:omp.newSession", "onCommand:omp.newSessionWithOptions"] },
					{ "id": "chat", "title": "Talk to omp", "description": "Commands, files, images, PDFs, shell, history.\n[Open chat](command:omp.focus)", "media": { "markdown": "media/walkthrough/chat.md" }, "completionEvents": ["onCommand:omp.focus", "onCommand:omp.openSession"] },
					{ "id": "review", "title": "Review and revert changes", "description": "Inline diffs, VS Code diffs, change markers, revert.\n[Review changes](command:omp.reviewChanges)", "media": { "markdown": "media/walkthrough/review.md" }, "completionEvents": ["onCommand:omp.reviewChanges"] },
					{ "id": "tasks", "title": "Queue tasks", "description": "Tasks with subtasks that run one after another in the background.\n[Add a task](command:omp.tasks.add)", "media": { "markdown": "media/walkthrough/tasks.md" }, "completionEvents": ["onCommand:omp.tasks.add"] },
					{ "id": "editor", "title": "Use omp from the editor", "description": "Fix with omp, add files, terminal output, git chores.", "media": { "markdown": "media/walkthrough/editor.md" }, "completionEvents": ["onCommand:omp.fixDiagnostics", "onCommand:omp.addToChat", "onCommand:omp.scm.commit"] }
				]
			}
		],
		"keybindings": [
			{
				"command": "omp.focus",
				"key": "ctrl+alt+o",
				"mac": "cmd+alt+o"
			},
			{
				"command": "omp.sendSelection",
				"key": "ctrl+alt+k",
				"mac": "cmd+alt+k",
				"when": "editorTextFocus"
			}
		],
		"configuration": {
			"title": "omp",
			"properties": {
				"omp.path": {
					"type": "string",
					"default": "",
					"description": "Path to the omp executable on the machine running the extension. Empty = search PATH, ~/.local/bin, ~/.bun/bin."
				},
				"omp.extraArgs": {
					"type": "array",
					"items": {
						"type": "string"
					},
					"default": [],
					"description": "Extra omp CLI arguments for new sessions, e.g. [\"--model\", \"opus\"]."
				},
				"omp.sendWhileBusy": {
					"type": "string",
					"enum": [
						"steer",
						"followUp"
					],
					"default": "steer",
					"enumDescriptions": [
						"Inject the message into the running turn.",
						"Queue the message to run after the current turn."
					],
					"description": "What Enter does while the agent is working."
				},
				"omp.panelLocation": {
					"type": "string",
					"enum": [
						"beside",
						"active"
					],
					"default": "beside",
					"description": "Editor column for chat panels."
				},
				"omp.chatLocation": {
					"type": "string",
					"enum": ["editor", "sidebar"],
					"default": "editor",
					"enumDescriptions": ["Open chats as editor tabs (several side by side).", "Open chats in the omp Chat view (move it to the secondary side bar to keep it next to your code)."],
					"description": "Where clicking a session opens its chat."
				},
				"omp.groupBy": {
					"type": "string",
					"enum": [
						"project",
						"none"
					],
					"default": "project",
					"enumDescriptions": [
						"Group sessions under their project (git repository, else folder).",
						"Flat list for this workspace."
					],
					"description": "How the Sessions view organizes sessions."
				},
				"omp.showAllSessions": {
					"type": "boolean",
					"default": false,
					"description": "Also list stopped sessions from folders outside this workspace."
				},
				"omp.saveBeforePrompt": {
					"type": "boolean",
					"default": true,
					"description": "Save unsaved editors inside the session folder before sending a prompt, so omp sees what you see."
				},
				"omp.notifications": {
					"type": "boolean",
					"default": true,
					"description": "Notify when a session finishes or needs input while its chat is not visible."
				},
				"omp.showChangeDecorations": {
					"type": "boolean",
					"default": true,
					"description": "Mark files changed by omp sessions in the Explorer and show their changed lines (gutter + CodeLens with diff/revert) in editors."
				}
			}
		}
	},
	"scripts": {
		"build": "node build.mjs",
		"watch": "node build.mjs --watch",
		"typecheck": "tsc --noEmit -p .",
		"vscode:prepublish": "npm run typecheck && node build.mjs --production",
		"package": "node -e \"require('fs').mkdirSync('dist',{recursive:true})\" && vsce package --no-dependencies -o dist/",
		"install-local": "npm run package && sh scripts/install-local.sh",
		"publish:vsce": "vsce publish --no-dependencies",
		"publish:ovsx": "npx --yes ovsx publish --no-dependencies",
		"test:e2e:desktop": "tsc --noEmit -p test/e2e-desktop && node test/e2e-desktop/run.mjs",
		"test": "node test/run.mjs",
		"test:unit": "node test/run.mjs unit",
		"test:host": "node test/run.mjs host"
	},
	"devDependencies": {
		"@types/mocha": "^10.0.10",
		"@types/node": "^22.20.5",
		"@types/vscode": "^1.100.0",
		"@vscode/test-electron": "^3.1.0",
		"@vscode/vsce": "^4.1.0",
		"esbuild": "^0.28.2",
		"highlight.js": "^11.12.0",
		"marked": "^18.1.3",
		"mocha": "^11.8.0",
		"typescript": "^7.0.2"
	}
}
