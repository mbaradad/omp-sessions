{
	"name": "omp-sessions",
	"displayName": "omp Sessions",
	"description": "Run oh-my-pi (omp) coding-agent sessions in the background, locally or over Remote-SSH. Detach and reattach, queue tasks, review native diffs and revert changes.",
	"version": "0.4.0",
	"publisher": "mbaradad",
	"license": "MIT",
	"author": "Manel Baradad <manelbaradad@gmail.com>",
	"private": true,
	"icon": "media/icon.png",
	"repository": {
		"type": "git",
		"url": "https://github.com/mbaradad/omp-vscode.git"
	},
	"bugs": {
		"url": "https://github.com/mbaradad/omp-vscode/issues"
	},
	"homepage": "https://github.com/mbaradad/omp-vscode#readme",
	"qna": "https://github.com/mbaradad/omp-vscode/issues",
	"preview": true,
	"keywords": [
		"omp",
		"oh-my-pi",
		"pi",
		"ai",
		"agent",
		"coding agent",
		"ai agent",
		"background agent",
		"background",
		"remote ssh",
		"remote-ssh",
		"ssh",
		"detach",
		"llm",
		"claude",
		"anthropic",
		"gpt",
		"openai",
		"gemini",
		"chat",
		"diff",
		"code review",
		"task queue",
		"refactor",
		"pair programming"
	],
	"galleryBanner": {
		"color": "#1a1124",
		"theme": "dark"
	},
	"engines": {
		"vscode": "^1.100.0"
	},
	"extensionKind": [
		"workspace"
	],
	"capabilities": {
		"untrustedWorkspaces": {
			"supported": false,
			"description": "omp is a coding agent: it runs shell commands, edits files and loads project configuration (AGENTS.md, .omp/) from the folder, and the extension starts the binary named by the workspace-overridable `omp.path`/`omp.extraArgs` settings. Trust the folder to use it."
		},
		"virtualWorkspaces": {
			"supported": false,
			"description": "Sessions run omp as a process on the file system of the extension host; virtual file systems are not reachable from it."
		}
	},
	"categories": [
		"AI",
		"Chat",
		"Other"
	],
	"main": "./out/extension.js",
	"activationEvents": [
		"onStartupFinished",
		"onWebviewPanel:omp.chat"
	],
	"contributes": {
		"viewsContainers": {
			"activitybar": [
				{
					"id": "omp",
					"title": "omp",
					"icon": "media/omp.svg"
				}
			]
		},
		"views": {
			"omp": [
				{
					"id": "omp.sessions",
					"name": "Sessions",
					"icon": "media/omp.svg"
				},
				{
					"type": "webview",
					"id": "omp.chatView",
					"name": "Chat",
					"icon": "media/omp.svg"
				},
				{
					"id": "omp.tasks",
					"name": "Tasks",
					"icon": "$(checklist)"
				}
			]
		},
		"viewsWelcome": [
			{
				"view": "omp.sessions",
				"contents": "No omp sessions for this workspace yet.\n[Start omp session](command:omp.newSession)\n[Resume an omp transcript](command:omp.resumeFromHistory)\nSessions keep running on this machine when VS Code disconnects."
			},
			{
				"view": "omp.tasks",
				"contents": "Queue work for omp: tasks run one after another in the background, even with VS Code closed. Subtasks, drag & drop to reorder, check to complete.\n[Add task](command:omp.tasks.add)"
			}
		],
		"commands": [
			{ "command": "omp.doctor", "title": "Run Doctor", "category": "omp", "icon": "$(pulse)" },
			{ "command": "omp.copyDiagnostics", "title": "Copy Diagnostics", "category": "omp" },
			{ "command": "omp.reportIssue", "title": "Report Issue…", "category": "omp", "icon": "$(report)" },
			{ "command": "omp.installOmp", "title": "Install omp…", "category": "omp", "icon": "$(cloud-download)" },
			{ "command": "omp.setOmpPath", "title": "Set omp Executable Path…", "category": "omp" },
			{ "command": "omp.showOmpMissing", "title": "omp Is Not Installed", "category": "omp" },
			{ "command": "omp.upgradeSession", "title": "Upgrade Session Host", "category": "omp", "icon": "$(sync)" },
			{ "command": "omp.upgradeAllSessions", "title": "Upgrade All Session Hosts", "category": "omp", "icon": "$(sync)" },
			{ "command": "omp.cleanUpSnapshots", "title": "Clean Up File Snapshots…", "category": "omp", "icon": "$(trash)" },
			{ "command": "omp.dashboard", "title": "Usage Dashboard", "category": "omp", "icon": "$(graph)" },
			{ "command": "omp.searchHistory", "title": "Search Session History…", "category": "omp", "icon": "$(search)" },
			{ "command": "omp.todayCost", "title": "Show Today's Spend", "category": "omp", "icon": "$(pulse)" },
			{ "command": "omp.newWorktreeSession", "title": "New Session in Git Worktree…", "category": "omp", "icon": "$(git-branch)" },
			{ "command": "omp.bestOfN", "title": "Best-of-N: Same Task in Parallel Worktrees…", "category": "omp", "icon": "$(git-compare)" },
			{ "command": "omp.worktree.diff", "title": "Compare Worktree Branch with Base", "category": "omp", "icon": "$(git-compare)" },
			{ "command": "omp.worktree.merge", "title": "Merge Worktree Branch into Main Checkout…", "category": "omp", "icon": "$(git-merge)" },
			{ "command": "omp.worktree.openFolder", "title": "Open Worktree in New Window", "category": "omp", "icon": "$(empty-window)" },
			{ "command": "omp.worktree.remove", "title": "Remove Worktree and Session…", "category": "omp", "icon": "$(trash)" },
			{ "command": "omp.board", "title": "Open Sessions Board", "category": "omp", "icon": "$(layout)" },
			{ "command": "omp.sessionSettings", "title": "Session Settings…", "category": "omp", "icon": "$(settings-gear)" },
			{ "command": "omp.bridgeStatus", "title": "VS Code Bridge: Show Status", "category": "omp", "icon": "$(plug)" },
			{
				"command": "omp.newSession",
				"title": "New Session",
				"category": "omp",
				"icon": "$(add)"
			},
			{
				"command": "omp.newSessionWithOptions",
				"title": "New Session with Options…",
				"category": "omp",
				"icon": "$(settings-gear)"
			},
			{
				"command": "omp.reviewChanges",
				"title": "Review Changes",
				"category": "omp",
				"icon": "$(diff-multiple)"
			},
			{
				"command": "omp.openSession",
				"title": "Open Session…",
				"category": "omp",
				"icon": "$(comment-discussion)"
			},
			{
				"command": "omp.focus",
				"title": "Focus Chat",
				"category": "omp"
			},
			{
				"command": "omp.stopSession",
				"title": "Stop Session",
				"category": "omp",
				"icon": "$(debug-stop)"
			},
			{
				"command": "omp.resumeSession",
				"title": "Resume Session",
				"category": "omp",
				"icon": "$(debug-start)"
			},
			{
				"command": "omp.deleteSession",
				"title": "Remove Session",
				"category": "omp",
				"icon": "$(trash)"
			},
			{
				"command": "omp.renameSession",
				"title": "Rename Session…",
				"category": "omp",
				"icon": "$(edit)"
			},
			{
				"command": "omp.showChanges",
				"title": "Show Changed Files…",
				"category": "omp",
				"icon": "$(list-tree)"
			},
			{
				"command": "omp.openSessionFileDiff",
				"title": "Open Session Diff",
				"category": "omp"
			},
			{
				"command": "omp.resumeFromHistory",
				"title": "Resume omp Transcript in Background…",
				"category": "omp",
				"icon": "$(history)"
			},
			{
				"command": "omp.sendSelection",
				"title": "Send Selection to omp",
				"category": "omp"
			},
			{
				"command": "omp.showLog",
				"title": "Show Session Host Log",
				"category": "omp",
				"icon": "$(output)"
			},
			{
				"command": "omp.refresh",
				"title": "Refresh",
				"category": "omp",
				"icon": "$(refresh)"
			},
			{
				"command": "omp.toggleGrouping",
				"title": "Toggle Group by Project",
				"category": "omp",
				"icon": "$(list-tree)"
			},
			{
				"command": "omp.addToChat",
				"title": "Add to omp Chat",
				"category": "omp",
				"icon": "$(mention)"
			},
			{
				"command": "omp.sendTerminalSelection",
				"title": "Send Terminal Selection to omp",
				"category": "omp",
				"icon": "$(terminal)"
			},
			{
				"command": "omp.explainSelection",
				"title": "Explain Selection with omp",
				"category": "omp",
				"icon": "$(question)"
			},
			{
				"command": "omp.askAboutSelection",
				"title": "Ask omp about Selection…",
				"category": "omp",
				"icon": "$(comment)"
			},
			{
				"command": "omp.fixDiagnostics",
				"title": "Fix Problems at Cursor with omp",
				"category": "omp",
				"icon": "$(wrench)"
			},
			{
				"command": "omp.revertFile",
				"title": "Revert File to Before Session",
				"category": "omp",
				"icon": "$(discard)"
			},
			{ "command": "omp.openInSidebar", "title": "Open in Side Bar", "category": "omp", "icon": "$(layout-sidebar-left)" },
			{ "command": "omp.openInEditor", "title": "Open in Editor Tab", "category": "omp", "icon": "$(go-to-file)" },
			{ "command": "omp.scm.commit", "title": "Commit with omp", "category": "omp", "icon": "$(git-commit)" },
			{ "command": "omp.scm.review", "title": "Review Uncommitted Changes with omp", "category": "omp", "icon": "$(checklist)" },
			{ "command": "omp.scm.pr", "title": "Write PR Description with omp", "category": "omp", "icon": "$(git-pull-request)" },
			{
				"command": "omp.tasks.add",
				"title": "Add Task…",
				"category": "omp",
				"icon": "$(add)"
			},
			{
				"command": "omp.tasks.addSubtask",
				"title": "Add Subtask…",
				"category": "omp",
				"icon": "$(list-tree)"
			},
			{
				"command": "omp.tasks.edit",
				"title": "Rename…",
				"category": "omp",
				"icon": "$(edit)"
			},
			{
				"command": "omp.tasks.editNotes",
				"title": "Edit Details…",
				"category": "omp",
				"icon": "$(note)"
			},
			{
				"command": "omp.tasks.delete",
				"title": "Delete",
				"category": "omp",
				"icon": "$(trash)"
			},
			{
				"command": "omp.tasks.runNow",
				"title": "Run Now",
				"category": "omp",
				"icon": "$(play)"
			},
			{
				"command": "omp.tasks.start",
				"title": "Start Queue",
				"category": "omp",
				"icon": "$(run-all)"
			},
			{
				"command": "omp.tasks.pause",
				"title": "Pause Queue",
				"category": "omp",
				"icon": "$(debug-pause)"
			},
			{
				"command": "omp.tasks.markDone",
				"title": "Mark Done",
				"category": "omp",
				"icon": "$(check)"
			},
			{
				"command": "omp.tasks.markPending",
				"title": "Mark Pending (re-run)",
				"category": "omp",
				"icon": "$(refresh)"
			},
			{
				"command": "omp.tasks.skip",
				"title": "Skip",
				"category": "omp",
				"icon": "$(circle-slash)"
			},
			{
				"command": "omp.tasks.moveUp",
				"title": "Move Up",
				"category": "omp",
				"icon": "$(arrow-up)"
			},
			{
				"command": "omp.tasks.moveDown",
				"title": "Move Down",
				"category": "omp",
				"icon": "$(arrow-down)"
			},
			{
				"command": "omp.tasks.clearDone",
				"title": "Clear Finished Tasks",
				"category": "omp",
				"icon": "$(clear-all)"
			},
			{
				"command": "omp.tasks.openChat",
				"title": "Open Chat",
				"category": "omp",
				"icon": "$(comment-discussion)"
			},
			{ "command": "omp.tasks.editOptions", "title": "Task Options…", "category": "omp", "icon": "$(settings-gear)" },
			{ "command": "omp.tasks.duplicate", "title": "Duplicate Task", "category": "omp", "icon": "$(copy)" },
			{ "command": "omp.tasks.retryFailed", "title": "Retry Failed Tasks", "category": "omp", "icon": "$(refresh)" },
			{ "command": "omp.tasks.schedule", "title": "Schedule Queue Start…", "category": "omp", "icon": "$(clock)" },
			{ "command": "omp.editWithOmp", "title": "Edit with omp…", "category": "omp", "icon": "$(sparkle)" },
			{ "command": "omp.fixFileProblems", "title": "Fix File Problems with omp", "category": "omp", "icon": "$(wrench)" },
			{ "command": "omp.fixWorkspaceProblems", "title": "Fix Workspace Errors with omp", "category": "omp", "icon": "$(wrench)" },
			{ "command": "omp.fixLastFailedCommand", "title": "Fix Failed Command with omp", "category": "omp", "icon": "$(wrench)" },
			{ "command": "omp.explainFile", "title": "Explain File with omp", "category": "omp", "icon": "$(question)" },
			{ "command": "omp.writeTests", "title": "Write Tests with omp", "category": "omp", "icon": "$(beaker)" },
			{ "command": "omp.addDocs", "title": "Add Docs with omp", "category": "omp", "icon": "$(book)" },
			{ "command": "omp.commandCenter", "title": "Command Center", "category": "omp", "icon": "$(rocket)" },
			{ "command": "omp.login", "title": "Log In to a Model Provider", "category": "omp", "icon": "$(account)" },
			{ "command": "omp.update", "title": "Update omp", "category": "omp", "icon": "$(cloud-download)" },
			{ "command": "omp.setup", "title": "Run omp Setup", "category": "omp", "icon": "$(tools)" },
			{ "command": "omp.plugins", "title": "Manage Plugins…", "category": "omp", "icon": "$(extensions)" },
			{ "command": "omp.skills", "title": "Manage Skills…", "category": "omp", "icon": "$(lightbulb)" },
			{ "command": "omp.usage", "title": "Show Provider Usage Limits", "category": "omp", "icon": "$(pulse)" },
			{ "command": "omp.stats", "title": "Show Usage Statistics", "category": "omp", "icon": "$(graph)" },
			{ "command": "omp.models", "title": "Browse Models…", "category": "omp", "icon": "$(hubot)" },
			{ "command": "omp.cleanse", "title": "Cleanse Project Diagnostics…", "category": "omp", "icon": "$(sparkle)" },
			{ "command": "omp.commitInTerminal", "title": "Commit with omp in Terminal…", "category": "omp", "icon": "$(git-commit)" },
			{ "command": "omp.gitUi", "title": "Open omp Git UI", "category": "omp", "icon": "$(source-control)" },
			{ "command": "omp.exportHtml", "title": "Export Session as HTML…", "category": "omp", "icon": "$(export)" },
			{ "command": "omp.share", "title": "Share Session…", "category": "omp", "icon": "$(live-share)" },
			{ "command": "omp.continueInTerminal", "title": "Continue Session in Terminal", "category": "omp", "icon": "$(terminal)" },
			{ "command": "omp.importClaude", "title": "Import Claude Code Session…", "category": "omp", "icon": "$(sign-in)" },
			{ "command": "omp.importCodex", "title": "Import Codex Session…", "category": "omp", "icon": "$(sign-in)" },
			{ "command": "omp.openDocs", "title": "Open Documentation", "category": "omp", "icon": "$(book)" },
			{ "command": "omp.openConfig", "title": "Open omp Config File", "category": "omp", "icon": "$(gear)" },
			{ "command": "omp.keyboardShortcuts", "title": "Keyboard Shortcuts", "category": "omp", "icon": "$(record-keys)" }
		],
		"menus": {
			"view/title": [
			{ "command": "omp.board", "when": "view == omp.sessions", "group": "2_board@1" },
				{ "command": "omp.doctor", "when": "view == omp.sessions", "group": "9_help@1" },
				{ "command": "omp.reportIssue", "when": "view == omp.sessions", "group": "9_help@2" },
				{ "command": "omp.searchHistory", "when": "view == omp.sessions", "group": "3_usage@1" },
				{ "command": "omp.dashboard", "when": "view == omp.sessions", "group": "3_usage@2" },
				{ "command": "omp.newWorktreeSession", "when": "view == omp.sessions", "group": "1_new@2" },
				{ "command": "omp.bestOfN", "when": "view == omp.sessions", "group": "1_new@3" },
				{
					"command": "omp.newSession",
					"when": "view == omp.sessions",
					"group": "navigation@1"
				},
				{
					"command": "omp.resumeFromHistory",
					"when": "view == omp.sessions",
					"group": "navigation@2"
				},
				{
					"command": "omp.refresh",
					"when": "view == omp.sessions",
					"group": "navigation@3"
				},
				{
					"command": "omp.newSessionWithOptions",
					"when": "view == omp.sessions",
					"group": "1_new@1"
				},
				{
					"command": "omp.toggleGrouping",
					"when": "view == omp.sessions",
					"group": "2_view@1"
				},
				{
					"command": "omp.tasks.add",
					"when": "view == omp.tasks",
					"group": "navigation@1"
				},
				{
					"command": "omp.tasks.start",
					"when": "view == omp.tasks",
					"group": "navigation@2"
				},
				{
					"command": "omp.tasks.pause",
					"when": "view == omp.tasks",
					"group": "navigation@3"
				},
				{
					"command": "omp.tasks.clearDone",
					"when": "view == omp.tasks",
					"group": "1_tasks@1"
				},
				{ "command": "omp.fixWorkspaceProblems", "when": "view == workbench.panel.markers.view", "group": "navigation@9" },
				{ "command": "omp.commandCenter", "when": "view == omp.sessions", "group": "0_center@1" },
				{ "command": "omp.importClaude", "when": "view == omp.sessions", "group": "1_new@8" },
				{ "command": "omp.importCodex", "when": "view == omp.sessions", "group": "1_new@9" }
			],
			"view/item/context": [
				{ "command": "omp.upgradeSession", "when": "view == omp.sessions && viewItem =~ /^session\\.running/", "group": "2_lifecycle@9" },
				{ "command": "omp.newWorktreeSession", "when": "view == omp.sessions && viewItem == project", "group": "1_project@2" },
				{ "command": "omp.bestOfN", "when": "view == omp.sessions && viewItem == project", "group": "1_project@3" },
				{ "command": "omp.worktree.diff", "when": "view == omp.sessions && viewItem =~ /^session\\.[a-z]+\\.worktree/", "group": "3_worktree@1" },
				{ "command": "omp.worktree.merge", "when": "view == omp.sessions && viewItem =~ /^session\\.[a-z]+\\.worktree/", "group": "3_worktree@2" },
				{ "command": "omp.worktree.openFolder", "when": "view == omp.sessions && viewItem =~ /^session\\.[a-z]+\\.worktree/", "group": "3_worktree@3" },
				{ "command": "omp.worktree.remove", "when": "view == omp.sessions && viewItem =~ /^session\\.[a-z]+\\.worktree/", "group": "3_worktree@4" },
				{ "command": "omp.openInSidebar", "when": "view == omp.sessions && viewItem =~ /^session/", "group": "0_open@1" },
				{ "command": "omp.openInEditor", "when": "view == omp.sessions && viewItem =~ /^session/", "group": "0_open@2" },
				{
					"command": "omp.tasks.add",
					"when": "view == omp.tasks && viewItem =~ /^tasks\\.session/",
					"group": "inline@1"
				},
				{
					"command": "omp.tasks.start",
					"when": "view == omp.tasks && viewItem == tasks.session.paused",
					"group": "inline@2"
				},
				{
					"command": "omp.tasks.pause",
					"when": "view == omp.tasks && viewItem == tasks.session.auto",
					"group": "inline@2"
				},
				{
					"command": "omp.tasks.openChat",
					"when": "view == omp.tasks && viewItem =~ /^tasks\\.session/",
					"group": "inline@3"
				},
				{
					"command": "omp.tasks.clearDone",
					"when": "view == omp.tasks && viewItem =~ /^tasks\\.session/",
					"group": "1_session@1"
				},
				{
					"command": "omp.tasks.schedule",
					"when": "view == omp.tasks && viewItem =~ /^tasks\\.session/",
					"group": "1_session@2"
				},
				{
					"command": "omp.tasks.retryFailed",
					"when": "view == omp.tasks && viewItem =~ /^tasks\\.session/",
					"group": "1_session@3"
				},
				{
					"command": "omp.tasks.runNow",
					"when": "view == omp.tasks && viewItem =~ /^tasks\\.task\\.(pending|failed|skipped|done)$/",
					"group": "inline@1"
				},
				{
					"command": "omp.tasks.addSubtask",
					"when": "view == omp.tasks && viewItem =~ /^tasks\\.task\\./",
					"group": "inline@2"
				},
				{
					"command": "omp.tasks.delete",
					"when": "view == omp.tasks && viewItem =~ /^tasks\\.(task\\.(pending|failed|skipped|done)|subtask)$/",
					"group": "inline@3"
				},
				{
					"command": "omp.tasks.edit",
					"when": "view == omp.tasks && viewItem =~ /^tasks\\.(task\\.|subtask)/",
					"group": "1_edit@1"
				},
				{
					"command": "omp.tasks.editNotes",
					"when": "view == omp.tasks && viewItem =~ /^tasks\\.task\\./",
					"group": "1_edit@2"
				},
				{
					"command": "omp.tasks.editOptions",
					"when": "view == omp.tasks && viewItem =~ /^tasks\\.task\\./",
					"group": "1_edit@3"
				},
				{
					"command": "omp.tasks.duplicate",
					"when": "view == omp.tasks && viewItem =~ /^tasks\\.task\\./",
					"group": "1_edit@4"
				},
				{
					"command": "omp.tasks.moveUp",
					"when": "view == omp.tasks && viewItem =~ /^tasks\\.(task\\.|subtask)/",
					"group": "2_move@1"
				},
				{
					"command": "omp.tasks.moveDown",
					"when": "view == omp.tasks && viewItem =~ /^tasks\\.(task\\.|subtask)/",
					"group": "2_move@2"
				},
				{
					"command": "omp.tasks.markDone",
					"when": "view == omp.tasks && viewItem =~ /^tasks\\.task\\.(pending|failed|skipped)$/",
					"group": "3_status@1"
				},
				{
					"command": "omp.tasks.markPending",
					"when": "view == omp.tasks && viewItem =~ /^tasks\\.task\\.(done|failed|skipped)$/",
					"group": "3_status@2"
				},
				{
					"command": "omp.tasks.skip",
					"when": "view == omp.tasks && viewItem == tasks.task.pending",
					"group": "3_status@3"
				},
				{
					"command": "omp.tasks.openChat",
					"when": "view == omp.tasks && viewItem =~ /^tasks\\.task\\./",
					"group": "4_open@1"
				},
				{
					"command": "omp.tasks.delete",
					"when": "view == omp.tasks && viewItem =~ /^tasks\\.(task\\.(pending|failed|skipped|done)|subtask)$/",
					"group": "5_delete@1"
				},
				{
					"command": "omp.stopSession",
					"when": "view == omp.sessions && viewItem =~ /^session\\.running/",
					"group": "inline@2"
				},
				{
					"command": "omp.resumeSession",
					"when": "view == omp.sessions && viewItem =~ /^session\\.stopped/",
					"group": "inline@1"
				},
				{
					"command": "omp.deleteSession",
					"when": "view == omp.sessions && viewItem =~ /^session\\.stopped/",
					"group": "inline@2"
				},
				{
					"command": "omp.newSession",
					"when": "view == omp.sessions && viewItem == project",
					"group": "inline@0"
				},
				{
					"command": "omp.newSessionWithOptions",
					"when": "view == omp.sessions && viewItem == project",
					"group": "1_project@1"
				},
				{
					"command": "omp.reviewChanges",
					"when": "view == omp.sessions && viewItem =~ /^session/",
					"group": "inline@0"
				},
				{
					"command": "omp.reviewChanges",
					"when": "view == omp.sessions && viewItem =~ /^session/",
					"group": "1_session@0"
				},
				{
					"command": "omp.sessionSettings",
					"when": "view == omp.sessions && viewItem =~ /^session/",
					"group": "1_session@9"
				},
				{
					"command": "omp.showChanges",
					"when": "view == omp.sessions && viewItem =~ /^session/",
					"group": "1_session@1"
				},
				{
					"command": "omp.renameSession",
					"when": "view == omp.sessions && viewItem =~ /^session/",
					"group": "1_session@2"
				},
				{
					"command": "omp.showLog",
					"when": "view == omp.sessions && viewItem =~ /^session/",
					"group": "1_session@3"
				},
				{
					"command": "omp.stopSession",
					"when": "view == omp.sessions && viewItem =~ /^session\\.running/",
					"group": "2_lifecycle@1"
				},
				{
					"command": "omp.resumeSession",
					"when": "view == omp.sessions && viewItem =~ /^session\\.stopped/",
					"group": "2_lifecycle@1"
				},
				{
					"command": "omp.deleteSession",
					"when": "view == omp.sessions && viewItem =~ /^session\\.stopped/",
					"group": "2_lifecycle@2"
				},
				{
					"command": "omp.revertFile",
					"when": "view == omp.sessions && viewItem == file",
					"group": "inline@1"
				},
				{
					"command": "omp.revertFile",
					"when": "view == omp.sessions && viewItem == file",
					"group": "1_file@1"
				},
				{ "command": "omp.continueInTerminal", "when": "view == omp.sessions && viewItem =~ /^session/", "group": "3_omp@1" },
				{ "command": "omp.exportHtml", "when": "view == omp.sessions && viewItem =~ /^session/", "group": "3_omp@2" },
				{ "command": "omp.share", "when": "view == omp.sessions && viewItem =~ /^session/", "group": "3_omp@3" }
			],
			"editor/context": [
				{
					"command": "omp.sendSelection",
					"when": "editorHasSelection",
					"group": "omp@1"
				},
				{
					"command": "omp.explainSelection",
					"when": "editorHasSelection && resourceScheme == file",
					"group": "omp@2"
				},
				{
					"command": "omp.askAboutSelection",
					"when": "editorHasSelection && resourceScheme == file",
					"group": "omp@3"
				},
				{
					"command": "omp.addToChat",
					"when": "!editorHasSelection && resourceScheme == file",
