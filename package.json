		"@types/mocha": "^10.0.10",
		"@types/node": "^22.20.5",
		"@types/vscode": "^1.100.0",
		"@vscode/test-electron": "^3.1.0",
		"@vscode/vsce": "^4.1.0",
		"esbuild": "^0.28.2",
		"highlight.js": "^11.12.0",
		"marked": "^18.1.3",
		"mocha": "^11.8.0",
		"typescript": "^7.0.2"
	}
