				{
					"command": "omp.revertFile",
					"when": "false"
				},
				{
					"command": "omp.explainSelection",
					"when": "editorHasSelection && resourceScheme == file"
				},
				{
					"command": "omp.askAboutSelection",
					"when": "editorHasSelection && resourceScheme == file"
				},
				{
					"command": "omp.fixDiagnostics",
					"when": "editorIsOpen && resourceScheme == file"
				},
				{ "command": "omp.editWithOmp", "when": "editorIsOpen && resourceScheme == file" },
				{ "command": "omp.writeTests", "when": "editorIsOpen && resourceScheme == file" },
				{ "command": "omp.addDocs", "when": "editorIsOpen && resourceScheme == file" },
				{ "command": "omp.explainFile", "when": "editorIsOpen && resourceScheme == file" },
				{ "command": "omp.fixFileProblems", "when": "editorIsOpen && resourceScheme == file" },
				{ "command": "omp.cleanse", "when": "workspaceFolderCount > 0" },
				{ "command": "omp.commitInTerminal", "when": "workspaceFolderCount > 0" },
				{ "command": "omp.gitUi", "when": "workspaceFolderCount > 0" }
			],
			"editor/title/context": [
				{
					"command": "omp.addToChat",
					"when": "resourceScheme == file",
