		"walkthroughs": [
			{
				"id": "omp.gettingStarted",
				"title": "omp: background coding agent",
				"description": "Run omp sessions that keep working while VS Code is closed, review their changes, and queue work.",
				"steps": [
					{ "id": "start", "title": "Start a background session", "description": "Sessions survive VS Code, sleep and SSH drops.\n[Start a session](command:omp.newSession)", "media": { "markdown": "media/walkthrough/start.md" }, "completionEvents": ["onCommand:omp.newSession", "onCommand:omp.newSessionWithOptions"] },
					{ "id": "chat", "title": "Talk to omp", "description": "Commands, files, images, PDFs, shell, history.\n[Open chat](command:omp.focus)", "media": { "markdown": "media/walkthrough/chat.md" }, "completionEvents": ["onCommand:omp.focus", "onCommand:omp.openSession"] },
					{ "id": "review", "title": "Review and revert changes", "description": "Inline diffs, VS Code diffs, change markers, revert.\n[Review changes](command:omp.reviewChanges)", "media": { "markdown": "media/walkthrough/review.md" }, "completionEvents": ["onCommand:omp.reviewChanges"] },
					{ "id": "tasks", "title": "Queue tasks", "description": "Tasks with subtasks that run one after another in the background.\n[Add a task](command:omp.tasks.add)", "media": { "markdown": "media/walkthrough/tasks.md" }, "completionEvents": ["onCommand:omp.tasks.add"] },
					{ "id": "editor", "title": "Use omp from the editor", "description": "Fix with omp, add files, terminal output, git chores.", "media": { "markdown": "media/walkthrough/editor.md" }, "completionEvents": ["onCommand:omp.fixDiagnostics", "onCommand:omp.addToChat", "onCommand:omp.scm.commit"] }
				]
			}
		],
		"keybindings": [
			{
				"command": "omp.focus",
				"key": "ctrl+alt+o",
				"mac": "cmd+alt+o"
			},
			{
				"command": "omp.sendSelection",
				"key": "ctrl+alt+k",
				"mac": "cmd+alt+k",
				"when": "editorTextFocus"
			},
			{ "command": "omp.editWithOmp", "key": "ctrl+alt+e", "mac": "cmd+alt+e", "when": "editorTextFocus && !editorReadonly && resourceScheme == file" },
			{ "command": "omp.commandCenter", "key": "ctrl+alt+p", "mac": "cmd+alt+p" }
		],
		"configuration": {
			"title": "omp",
			"properties": {
				"omp.showTodayCost": { "type": "boolean", "default": true, "description": "Show today's omp spend (from session transcripts) in the status bar. Hidden on days without model calls." },
				"omp.dashboard.includeTerminalSessions": { "type": "boolean", "default": false, "description": "Usage dashboard and today's spend also count omp sessions started outside VS Code (all transcripts under ~/.omp/agent/sessions)." },
				"omp.snapshotRetentionDays": { "type": "number", "default": 14, "minimum": 0, "markdownDescription": "Days a stopped session must be unused before **omp: Clean Up File Snapshots** (and the Doctor report) offers to delete its file snapshots (the blobs behind change diffs and reverts)." },
				"omp.path": {
					"type": "string",
					"default": "",
					"description": "Path to the omp executable on the machine running the extension. Empty = search PATH, ~/.local/bin, ~/.bun/bin."
				},
				"omp.extraArgs": {
					"type": "array",
					"items": {
						"type": "string"
					},
					"default": [],
					"description": "Extra omp CLI arguments for new sessions, e.g. [\"--model\", \"opus\"]."
				},
				"omp.sendWhileBusy": {
					"type": "string",
					"enum": [
						"steer",
						"followUp"
					],
					"default": "steer",
					"enumDescriptions": [
						"Inject the message into the running turn.",
						"Queue the message to run after the current turn."
					],
					"description": "What Enter does while the agent is working."
				},
				"omp.panelLocation": {
					"type": "string",
					"enum": [
						"beside",
						"active"
					],
					"default": "beside",
					"description": "Editor column for chat panels."
				},
				"omp.chatLocation": {
					"type": "string",
					"enum": ["editor", "sidebar"],
					"default": "editor",
					"enumDescriptions": ["Open chats as editor tabs (several side by side).", "Open chats in the omp Chat view (move it to the secondary side bar to keep it next to your code)."],
					"description": "Where clicking a session opens its chat."
				},
				"omp.groupBy": {
					"type": "string",
					"enum": [
						"project",
						"none"
					],
					"default": "project",
					"enumDescriptions": [
						"Group sessions under their project (git repository, else folder).",
						"Flat list for this workspace."
					],
					"description": "How the Sessions view organizes sessions."
				},
				"omp.showAllSessions": {
					"type": "boolean",
					"default": false,
					"description": "Also list stopped sessions from folders outside this workspace."
				},
				"omp.saveBeforePrompt": {
					"type": "boolean",
					"default": true,
					"description": "Save unsaved editors inside the session folder before sending a prompt, so omp sees what you see."
				},
				"omp.notifications": {
					"type": "boolean",
					"default": true,
					"description": "Notify when a session finishes or needs input while its chat is not visible."
				},
				"omp.showChangeDecorations": {
					"type": "boolean",
					"default": true,
					"description": "Mark files changed by omp sessions in the Explorer and show their changed lines (gutter + CodeLens with diff/revert) in editors."
				},
				"omp.chat.toolCardsCollapsed": { "type": "boolean", "default": true, "description": "Show tool cards collapsed in the chat (edits and questions always start open). Alt+T or the chat menu collapses/expands all." },
				"omp.chat.snippets": { "type": "array", "default": [], "items": { "type": "object", "required": ["name", "prompt"], "properties": { "name": { "type": "string", "description": "Completion name: type /p:<name> in the composer." }, "prompt": { "type": "string", "description": "Text inserted into the composer. {{selection}} and {{file}} are replaced with the active editor's selection and path." }, "description": { "type": "string" } } }, "markdownDescription": "Prompt snippets offered in the chat composer as `/p:<name>`. Markdown files in the session folder's `.omp/prompts/` are added too (file name = snippet name, optional `description:` front matter). `{{selection}}` and `{{file}}` are filled in from the active editor." },
				"omp.terminalHints": {
					"type": "boolean",
					"default": true,
					"description": "After a command fails in a terminal inside a running session's folder, show \"omp: fix failed command?\" in the status bar for 15 seconds. (Fix Failed Command with omp works either way; needs VS Code shell integration.)"
				}
			}
		}
	},
	"scripts": {
		"build": "node build.mjs",
		"watch": "node build.mjs --watch",
		"typecheck": "tsc --noEmit -p .",
		"vscode:prepublish": "npm run typecheck && node build.mjs --production",
		"package": "node -e \"require('fs').mkdirSync('dist',{recursive:true})\" && vsce package --no-dependencies -o dist/",
		"install-local": "npm run package && sh scripts/install-local.sh",
		"publish:vsce": "vsce publish --no-dependencies",
		"publish:ovsx": "npx --yes ovsx publish --no-dependencies",
		"test:e2e:desktop": "tsc --noEmit -p test/e2e-desktop && node test/e2e-desktop/run.mjs",
		"test": "node test/run.mjs",
		"test:unit": "node test/run.mjs unit",
		"test:host": "node test/run.mjs host"
	},
